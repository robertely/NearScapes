NEARSCAPES_DATABASE_URL=postgresql+psycopg://nearscapes:nearscapes@postgres:5432/nearscapes
NEARSCAPES_REDIS_URL=redis://redis:6379/0
NEARSCAPES_QUEUE_MODE=dramatiq
NEARSCAPES_STORAGE_ROOT=/data
NEARSCAPES_MODEL_CACHE=/models
NEARSCAPES_LOG_LEVEL=INFO
NEARSCAPES_AUTO_ANALYZE_UPLOADS=true
NEARSCAPES_AUTO_AUDACITY_EXPORT=true
NEARSCAPES_ACCELERATOR=cpu
NEARSCAPES_INFERENCE_URL=http://host.docker.internal:8787
NEARSCAPES_INFERENCE_TIMEOUT_SECONDS=3600
NEARSCAPES_BIRDNET_CONFIDENCE_DEFAULT=0.85
NEARSCAPES_BIRDNET_GEO_CONFIDENCE_DEFAULT=0.03
NEARSCAPES_MAX_UPLOAD_BYTES=2147483648
NEARSCAPES_WAVEFORM_POINTS=4000
NEARSCAPES_PCM_SAMPLE_RATE=8000
NEARSCAPES_SLATE_FREQUENCY_HZ=1000
NEARSCAPES_SLATE_FREQUENCY_TOLERANCE_HZ=30
NEARSCAPES_SLATE_EXPECTED_DURATION_SECONDS=2.0
NEARSCAPES_SLATE_DURATION_TOLERANCE_SECONDS=0.5
NEARSCAPES_SLATE_MIN_TONE_TO_GUARD_DB=25
NEARSCAPES_SLATE_MIN_TONE_TO_BROADBAND_RATIO=0.03
NEARSCAPES_SLATE_MAX_PAIR_GAP_SECONDS=25
NEARSCAPES_SLATE_OPENING_PAIR_MAX_START_SECONDS=60
NEARSCAPES_SLATE_TRANSCRIPTION_CPU_MODEL=turbo
